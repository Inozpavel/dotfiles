{
  "group/hardware": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "disk"
    ]
  },
  "disk": {
    "interval": 30,
    "format": "|  󰋊  {percentage_used}% ",
    "path": "/",
    "on-click-right": "sh ~/scripts/systeminfo.sh"
  },
  "cpu": {
    "interval": 1,
    "format": "  {usage}%",
    "tooltip": true,
    "on-click-right": "sh ~/scripts/systeminfo.sh"
  },
  "memory": {
    "interval": 5,
    "format": "|   {used:0.1f}G ",
    "format-alt": "| {percentage}% 󰾆 ",
    "on-click-right": "sh ~/scripts/systeminfo.sh",
    "tooltip": true,
    "tooltip-format": "{used:0.1f}GB/{total:0.1f}G SWAP: {swapUsed:0.1f}G/{swapTotal:0.1f}G\n Available memory: {avail}G, swap: {swapAvail}G"
  }
}
